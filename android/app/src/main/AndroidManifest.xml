<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.petprogress.app" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Post notifications on Android 13+ (optional but recommended) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="PetProgress"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Deep links: myapp://complete|miss|skip|prev|next -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="myapp"/>
            </intent-filter>

            <!-- Default launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nightly 8pm nudge broadcast receiver -->
        <receiver
            android:name=".notify.NudgeReceiver"
            android:exported="false"/>
    </application>
</manifest>
